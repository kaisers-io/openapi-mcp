{
  "name": "@kaisers-io/openapi-mcp",
  "version": "0.1.0",
  "description": "Turn any OpenAPI spec into a strict, locally running MCP server",
  "license": "MIT",
  "bin": {
    "openapi-mcp": "./bin/openapi-mcp.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "@kaisers-io/openapi-mcp-core": "workspace:*",
    "commander": "15.0.0"
  },
  "engines": {
    "node": ">=24.12"
  }
}
