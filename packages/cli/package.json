{
  "name": "@kaisers-io/openapi-mcp",
  "version": "0.3.1",
  "description": "Turn any OpenAPI spec into a strict, locally running MCP server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaisers-io/openapi-mcp.git"
  },
  "bin": {
    "openapi-mcp": "bin/openapi-mcp.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "prepack": "tsdown"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "@kaisers-io/openapi-mcp-core": "workspace:*",
    "commander": "15.0.0",
    "undici": "8.12.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24.11.0"
  }
}
