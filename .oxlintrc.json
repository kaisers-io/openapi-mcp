{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error"
  },
  "rules": {
    "capitalized-comments": ["error", "always", { "ignoreConsecutiveComments": true }],
    // Off: object key order follows domain grouping (e.g. a schema's
    // properties ordered by protocol section), not the alphabet.
    "sort-keys": "off",
    // Off: import order follows domain grouping (external dependencies,
    // then internal modules grouped by subsystem), not the alphabet.
    "sort-imports": "off",
    // Off: protocol and byte-level constants (HTTP status codes, buffer/
    // line-length caps, timeout milliseconds, bit-shift widths) appear
    // throughout the transport and encoding code; naming every one as a
    // constant would bury the arithmetic in indirection without adding
    // clarity.
    "no-magic-numbers": "off",
    // s/m/h/d are the duration-unit suffix characters shared by
    // primitives.ts's DURATION_RE capture group and its UNIT_MS lookup
    // table (seconds/minutes/hours/days); z is the conventional
    // single-letter alias for the zod import used throughout the schema
    // modules. T is the idiomatic single-type-parameter name used across
    // several unrelated single-generic functions (cache/lock.ts's
    // withNamespaceLockImpl, spec/load.ts's readOrNotFound,
    // server/snapshot.ts's deepFreeze, and server/http/sessions.ts's
    // Session/SessionStore/createSessionStore) — renaming any one of them
    // would not let this exception be dropped, since the others still need
    // it, so it stays as the shared single-generic convention. cache/errors.ts's
    // withCacheErrors generic type parameters (formerly A and R) are named
    // TArgs/TResult instead, and toolgen/schema.ts's and toolgen/layout.ts's
    // single-letter locals (formerly v/k/t) are named value/keyword/name/
    // typeName per call site, so those exceptions are no longer needed.
    "id-length": ["error", { "min": 2, "exceptions": ["s", "m", "h", "d", "z", "T"] }],
    // Configured (not off): the top-level import-type style splits value and
    // type imports from the same module into two statements by design;
    // genuine duplicate value imports are still flagged.
    "no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    // Off: modules export many named symbols each (functions, types,
    // constants); forcing a single default export per file would fight
    // that structure rather than the other way around.
    "import/no-named-export": "off",
    // Off: exports are declared at their definition site (`export const`,
    // `export type`) throughout, so a module's exported surface is visible
    // next to each definition; collecting them into one trailing statement
    // would separate a declaration from its export for no benefit.
    "import/group-exports": "off",
    "import/no-nodejs-modules": "off", // Off: this is a Node runtime -- node: imports are the platform.
    // Off: same reasoning as import/group-exports above -- exports are
    // declared inline at their definition site, not collected at the
    // bottom of the file.
    "import/exports-last": "off",
    // Off: single-named-export modules keep the named export deliberately
    // (matching the no-default-exports convention the two overrides above
    // describe) rather than switching to `export default` for just that
    // one file.
    "import/prefer-default-export": "off",
    // Off: 303 sites remain across 62 files (heaviest: toolgen/schema.ts,
    // spec/pipeline.ts, spec/normalize.ts, cache/store.ts), nearly all
    // single-line value selections — e.g. errors.ts's error-normalization
    // `err instanceof Error ? err.message : String(err)` — where if/else
    // would triple the line count for the same type-narrowing expression.
    // Too broad for file-scoped overrides to stay honest, so the exception
    // stays global.
    "no-ternary": "off",
    // Off: 26 sites across 17 files (heaviest: server/execute/response.ts,
    // filter/engine.ts, cache/store.ts, spec/pipeline.ts) take more
    // parameters than the cap without decomposing into a smaller natural
    // grouping — e.g. cache/store.ts's promoteCandidateImpl and
    // cache/lock.ts's withNamespaceLockImpl (layout, fs, nowMs, plus
    // opts/run) — short of inventing an options object whose only caller
    // is the one call site. Too broad for file-scoped overrides to stay
    // honest, so the exception stays global.
    "max-params": "off",
    // Off: 203 sites across 74 files (heaviest: cache-store.test.ts,
    // toolgen/schema.ts, server-http-sessions.test.ts) exceed the
    // statement cap, typically one linear validation or fixture-setup pass
    // — e.g. headers.ts's resolveHeaderEnvMappings, which walks every
    // declared header once, validating and normalizing each; splitting
    // such a body into helper functions would scatter one pass across
    // multiple call frames for no gain in clarity. Too broad for
    // file-scoped overrides to stay honest, so the exception stays global.
    "max-statements": "off",
    // Off: 50 sites remain across 22 files (packages/core/src/cache/store.ts,
    // packages/core/src/spec/pipeline.ts, packages/core/src/spec/fetch.ts,
    // packages/core/src/http/pinned-dispatcher.ts, packages/core/src/http/egress.ts,
    // packages/core/src/cache/lock.ts, packages/core/src/filter/engine.ts,
    // packages/core/src/server/execute/request.ts,
    // packages/core/src/server/execute/executor.ts,
    // packages/core/src/server/sdk/streamable-http.ts,
    // packages/cli/src/context.ts, packages/cli/src/commands/serve.ts,
    // and ten *.test.ts files), each falling
    // into one of two inherent shapes reviewed and kept in the functional-
    // style pass: (1) a fallible value declared before a try so it is still
    // visible to code after the try/finally once the try assigns it (TDZ-safe
    // declare-then-assign, the sole way to escape a try block without an
    // `any`-typed outer binding), including test bodies that capture a
    // thrown error into a `caught` variable this way; and (2) a loop-carried
    // "best so far" accumulator (e.g. engine.ts's nearest-match search)
    // that must exist before the loop starts. The concentration (22 files)
    // is too broad for file-scoped overrides to stay honest, so the
    // exception stays global.
    "init-declarations": "off",
    // Off: 149 sites across 25 files (heaviest: egress.test.ts,
    // cli/test/serve.test.ts, http/egress.ts, server-dispatch.test.ts) put
    // a short justification directly on the line it documents — e.g.
    // egress.ts's classifyIpv4/classifyAddress branches, where each IANA
    // range/RFC citation sits on the exact condition it justifies; moving
    // those above the line would separate a citation from the check it
    // covers. Too broad for file-scoped overrides to stay honest, so the
    // exception stays global.
    "no-inline-comments": "off",
    // Off because it is unsatisfiable alongside the formatter: oxfmt rewrites
    // hexadecimal digits to lowercase while this rule demands uppercase, and
    // the rule accepts no configuration — enabling it would make `lint` and
    // `fmt:check` contradict each other on every hex literal.
    "unicorn/number-literal-case": "off",
    // Off: 191 sites across 69 files, test bodies included (heaviest:
    // cache-store.test.ts, cache/store.ts, server-http-sessions.test.ts),
    // exceed the line cap — fixed-order sequences of security-relevant
    // checks like egress.ts's assertAllowedRedirectTarget and fetch.ts's
    // fetchSpec (DNS-pinned lookup, redirect-target classification,
    // response-size accounting), plus describe/it bodies that walk one
    // scenario end to end; extracting steps into helpers would hide that
    // ordering dependency (or scatter one scenario) behind function
    // boundaries. Too broad for file-scoped overrides to stay honest, so
    // the exception stays global and covers **/*.test.ts too.
    "max-lines-per-function": "off",
    // Off: 45 sites across 10 files (heaviest: cli/test/serve-http.test.ts,
    // spec/fetch.ts, cache/store.ts, http/pinned-dispatcher.ts,
    // cli/src/context.ts), each an inherently serial loop — e.g. fetch.ts's
    // manual redirect loop and its streamed body read, where each hop
    // depends on the previous response's Location header and each chunk on
    // the previous one being consumed — plus test loops that must observe
    // one effect before causing the next. Nothing to parallelize, and too
    // broad for file-scoped overrides to stay honest, so the exception
    // stays global.
    "no-await-in-loop": "off",
    // Off: 19 sites across 8 files (server/execute/request.ts 5,
    // cache/store.ts 4, filter/pattern.ts 3, the rest spread thinner),
    // each using `continue` to skip to the next iteration once an item is
    // classified — e.g. fetch.ts's redirect loop advancing to the next hop
    // once the next URL is resolved; rewriting them as nested if/else
    // would deepen the indentation of each loop body for the same control
    // flow. Too broad for file-scoped overrides to stay honest, so the
    // exception stays global.
    "no-continue": "off"
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/coverage/**", "packages/*/bin/**"],
  "overrides": [
    {
      "files": ["packages/core/**/*.ts", "packages/cli/**/*.ts"],
      "rules": {
        // Configured (not off): both shipped packages (core and cli)
        // mandate `type` over `interface` everywhere an object shape is
        // declared (interface survives only where TypeScript technically
        // requires it, each such site carrying its own justifying comment)
        // -- the plugin default enforces the opposite direction, so this
        // flips it to match the packages' actual convention.
        "typescript/consistent-type-definitions": ["error", "type"]
      }
    },
    {
      "files": ["**/*.test.ts"],
      "plugins": ["vitest"],
      "rules": {
        // "vitest/prefer-called-once" and "vitest/prefer-called-times"
        // directly contradict each other for a `toHaveBeenCalledTimes(1)`
        // call site (one demands `toHaveBeenCalledOnce()`, the other
        // demands `toHaveBeenCalledTimes(1)` for the exact same assertion)
        // - no rewrite satisfies both simultaneously. Kept "prefer-called-times"
        // (it matches this codebase's existing convention, e.g.
        // context-createexclusive.test.ts's `toHaveBeenCalledTimes(0)`) and
        // turned the other off here rather than weakening the "style"
        // category as a whole.
        "vitest/prefer-called-once": "off",
        // Off: setup/teardown hooks (beforeEach/afterEach/beforeAll) are
        // used throughout the suite to share fixture setup (temp
        // directories, mocked clients, server instances) across the tests
        // in a describe block; inlining them would duplicate that setup in
        // every test body.
        "vitest/no-hooks": "off",
        // Off: many test bodies legitimately assert several related
        // properties of one outcome in a single test (e.g. every field of
        // a response envelope, or every argument a mock was called with);
        // the default cap of 5 would force splitting one cohesive
        // assertion into several single-purpose tests that each need the
        // same setup repeated.
        "vitest/max-expects": "off",
        // Off: 1322 sites across all 51 test files — effectively every
        // test in the suite — would need an expect.assertions(n) preamble;
        // the assertions are structural throughout (e.g.
        // spec-display.test.ts's "EXIT map" fixture asserting toEqual on a
        // whole array), not counted one by one, so the rule is off
        // suite-wide.
        "vitest/prefer-expect-assertions": "off",
        // Off: vitest globals (describe/it/expect) are deliberately
        // disabled project-wide, so spec-display.test.ts imports them
        // explicitly from 'vitest' instead of relying on ambient globals.
        "vitest/no-importing-vitest-globals": "off",
        // Off: spec-display.test.ts's "EXIT map" describe title names a
        // fixed data structure the tests exercise, not a sentence, so it
        // is capitalized like the identifier it names rather than
        // lowercased like a sentence.
        "vitest/prefer-lowercase-title": "off",
        // Off: spec-display.test.ts names a describe block after the
        // factory function under test rather than restating it as a
        // sentence describing behavior.
        "vitest/prefer-describe-function-title": "off",
        // Off: 319 sites across 41 test files (heaviest:
        // cache-store.test.ts, filter-engine.test.ts, pipeline.test.ts,
        // http-pinned-dispatcher.test.ts) use toEqual (structural
        // equality) on purpose, not toStrictEqual (which also checks
        // prototype and undefined keys); switching any of them would
        // change what the assertion actually verifies, which is a behavior
        // change to the test, not a style fix.
        "vitest/prefer-strict-equal": "off",
        // Off: primitives.test.ts asserts safeParse(...).success with
        // toBe(false), which is stricter than the falsy-check this rule
        // would substitute (success is typed boolean, so toBe(false) is
        // the exact check; toBeFalsy() would also pass for 0 or '').
        "vitest/prefer-to-be-falsy": "off",
        // Off: primitives.test.ts asserts inside a try/catch because the
        // code under test throws on the invalid branch and returns
        // normally on the valid one; the assertion belongs in whichever
        // branch actually runs, which the rule cannot see is exhaustive.
        "vitest/no-conditional-expect": "off",
        // Off: context.test.ts asserts `typeof ctx.homeDir()` with
        // toBe('string') because the value under test is a plain string,
        // not a class instance or branded type that expectTypeOf's static
        // type check would add anything to.
        "vitest/prefer-expect-type-of": "off",
        // Off: output.test.ts's sample payload fixture (`{ a: 1 }`) uses a
        // single-letter key because the test exercises payload shape, not
        // the key's name; renaming it to satisfy id-length would suggest a
        // meaning the fixture doesn't have.
        "id-length": "off",
        // Off: 288 sites across 29 test files (heaviest:
        // toolgen-schema.test.ts, toolgen-layout.test.ts,
        // filter-pattern.test.ts) assert typed booleans with toBe(true) —
        // e.g. doctor.test.ts's envelope.ok/cacheRootExists, or
        // safeParse(...).success — which is stricter than the truthy-check
        // this rule would substitute (toBeTruthy() also passes for 1 or 'x').
        "vitest/prefer-to-be-truthy": "off",
        // Off: main.test.ts defines inline CommandRegistrar closures
        // (boom/helpToStderr) inside the test body because they capture
        // per-test mock state (call counts, thrown errors) that a
        // module-scoped helper couldn't isolate between tests.
        "unicorn/consistent-function-scoping": "off",
        // Configured (not off): these are the repo's assertion-wrapper
        // helpers, so the rule can't see the expect(...) calls buried inside
        // them without this list - headers.test.ts and api-options.test.ts
        // each define their own local expectUsageError, filter-pattern.test.ts's
        // agree wraps the glob-vs-oracle expect, and http-pinned-dispatcher.test.ts's
        // rejectsWithCause wraps the rejects.toMatchObject expect. The rule
        // stays live for genuinely assertion-free tests.
        "vitest/expect-expect": [
          "error",
          { "assertFunctionNames": ["expect", "expectUsageError", "agree", "rejectsWithCause"] }
        ],
        // Off: load.test.ts narrows source.kind with an if inside the test
        // body because the fixture's SpecSource union must be narrowed
        // before its file-only or url-only field can be read; the
        // narrowing is the thing under test, not incidental control flow.
        "vitest/no-conditional-in-test": "off",
        // Off: 36 sites across 9 test files (heaviest:
        // toolgen-schema.test.ts) use literal `null` because the fixture
        // mirrors an API contract that itself uses null — e.g.
        // fetch.test.ts's absent `Response.body`/`Headers.get` returns, or
        // JSON Schema's null type and enum-member null — so `undefined`
        // would change what the fixture actually exercises.
        "unicorn/no-null": "off",
        // Off for tests: 23 test files exceed the line cap because a
        // coherent scenario suite lives in one file — e.g. fetch.test.ts's
        // redirect-chain suite, where each chained-hop fixture needs its
        // own mock response and assertions; splitting such a file would
        // separate a scenario from the single test verifying it end to end.
        "max-lines": "off",
        // Off: sanitize.test.ts and output.test.ts embed escaped
        // backslashes ('\\x', '\\u001b') as literal two-character string
        // content because that is the exact byte sequence the sanitizer is
        // asserted against; converting them to String.raw template
        // literals risks silently changing which characters the fixture
        // contains, for no runtime difference.
        "unicorn/prefer-string-raw": "off",
        // Off: cache-lock.test.ts and context.test.ts use
        // expect(await ...) rather than await expect(...).resolves
        // throughout because several of these assertions destructure or
        // transform the resolved value before asserting on it, which the
        // .resolves chain form doesn't support in the same expression.
        "vitest/prefer-expect-resolves": "off",
        // Off: context.test.ts's writeFileAtomic/readFileTextCapped
        // failure-path tests assert only that a real filesystem error is
        // thrown, not its exact message, because the message text (ENOENT
        // vs. EACCES wording, path formatting) is OS- and filesystem-
        // dependent and would make the test flaky across platforms.
        "vitest/require-to-throw-message": "off",
        // Off for tests: race/deadline scenarios (session eviction, shutdown
        // timers, cache-lock contention, DNS-abort races) are constructed
        // directly with `new Promise` to control exactly when a fixture
        // settles, mirroring the same non-abortable/event-emitter primitives
        // the src-side sites wrap
        "promise/avoid-new": "off",
        // Off for tests: fixtures assert against detached late-rejection
        // handlers and callback-contract bridges (mirroring pinnedLookup and
        // the DNS-race consumers in src) via `.then()`/`.catch()` chains
        "promise/prefer-await-to-then": "off",
        // Off for tests: fixtures call gzipSync/spawnSync/validateHopUrlSync
        // synchronously by design to set up deterministic input before
        // exercising the code under test
        "node/no-sync": "off"
      }
    },
    {
      "files": ["packages/core/src/spec/pipeline.ts"],
      "rules": {
        // Off for the pipeline only: it is the composition root of the spec
        // subsystem and imports load, parse, validate, dereference, normalize,
        // naming, budgets, fetch, cache paths/fs/store/ttl, and the filter engine
        "import/max-dependencies": "off",
        // Off: pipeline.ts is the spec subsystem's composition root -- policy
        // resolution, the fail-closed cache read, the conditional-refresh
        // decision, the cache-hit path, and the last-known-good fallback all
        // live together with the rationale for why each control-flow branch
        // is safe; splitting a branch into its own module would separate
        // that safety rationale from the invariant it guards.
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/core/src/cache/store.ts"],
      "rules": {
        // Off: store.ts is the transactional cache-store core -- schema
        // serialization, the incremental size preflight, both writers, GC,
        // the three-way meta read, and the public reader all share the
        // private readMetaFile helper; splitting an entry point out would
        // separate it from the shared invariant readMetaFile enforces for
        // all of them.
        "max-lines": "off",
        // Off: scoping import/max-dependencies to pipeline.ts's override
        // alone would leave the rule enforced here too, and store.ts
        // imports from 11 files for the same reason as its max-lines
        // override above -- it is the transactional store core and
        // genuinely depends on every one of them.
        "import/max-dependencies": "off",
        // Off: store.ts's writeAccepted and writeCandidate are declared
        // async with synchronous validation (declaredOpenapiVersion,
        // persistableTextOrThrow, the title/specVersion length check) BEFORE
        // the `return withNamespaceLock(...)` tail call. Removing `async`
        // would turn those synchronous throws into synchronous exceptions at
        // the call site instead of promise rejections, breaking every
        // `.rejects.toMatchObject` assertion against them.
        "require-await": "off"
      }
    },
    {
      "files": ["packages/core/src/filter/pattern.ts"],
      "rules": {
        // Off: pattern.ts is the whole glob-compilation module -- the
        // grammar constants, compileGlob, the step budget, and the Thompson
        // state-set matcher live together because the step-budget
        // accounting has to see the compiler's output and the matcher's
        // consumption of it in the same file; splitting either out would
        // separate the budget invariant from the code it bounds.
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/core/src/http/pinned-dispatcher.ts"],
      "rules": {
        // Off: pinnedLookup implements node:net's LookupFunction / undici's
        // connect.lookup contract, which Node itself defines as a callback
        // `(hostname, options, callback) => void` -- there is no async/await
        // form of this external API to refactor to.
        "promise/prefer-await-to-callbacks": "off",
        // Off: the LookupFunction callback's first parameter is typed
        // `NodeJS.ErrnoException | null` (not `| undefined`) by node:net
        // itself, so the success-path calls must pass the literal `null` to
        // satisfy that upstream type.
        "unicorn/no-null": "off",
        // Off: pinned-dispatcher.ts is the whole DNS-pinned transport module
        // -- createPinnedAgent (the pinning Agent) and pinnedRequest (the
        // manual-redirect transport built directly on it) share the
        // pinned-lookup invariant that every redirect hop must re-resolve
        // through; splitting pinnedRequest into its own file would separate
        // that invariant from the transport that depends on it holding.
        "max-lines": "off",
        // Off: TooLargeError (the over-cap sentinel readCapped throws) and
        // EgressError (the branded error the DNS-pinning lookup throws so a
        // fetch rejection can be classified reliably via its cause chain)
        // are two small, single-purpose sentinel classes serving two
        // distinct call sites within this one shared-transport module --
        // splitting either into its own file would separate a brand from
        // the single guard it exists to make provable.
        "max-classes-per-file": "off"
      }
    },
    {
      "files": ["packages/core/src/toolgen/schema.ts"],
      "rules": {
        // Off: schema.ts is the full JSON-Schema-to-Zod converter -- the
        // malformed-value gate, the keyword allowlist, the sibling-conflict
        // gate, nullable/multi-type normalization, and every leaf branch
        // (string/number/integer/boolean/null/const/enum/typeless) share the
        // same input-shape invariant the malformed-value gate establishes;
        // splitting a leaf branch into its own file would separate it from
        // the gate that guarantees its input is already well-formed.
        "max-lines": "off",
        // Off: the "oneOf / anyOf + type" comment in conflictingCombination
        // intentionally starts with the lowercase JSON-Schema keyword names
        // oneOf/anyOf -- capitalizing them would misname the keywords the
        // comment refers to.
        "capitalized-comments": "off"
      }
    },
    {
      "files": ["packages/core/test/toolgen-schema.test.ts"],
      "rules": {
        // Off: several comments in this test file intentionally start with
        // a lowercase code identifier (nullable, numberSchema, enum,
        // pattern) to name the exact keyword/function being discussed --
        // capitalizing them would misname the identifier they refer to.
        "capitalized-comments": "off"
      }
    },
    {
      "files": ["packages/core/src/toolgen/layout.ts"],
      "rules": {
        // Off: layout.ts is the whole field-layout module -- paramFields,
        // the body classification (bodyFields/isFlattenableRoot/
        // selectMedia), collision resolution, and buildLayout's assembly
        // (including the optional-body all-or-nothing refine) share the one
        // field-collision invariant that collision resolution enforces
        // across all of them; splitting a piece out would separate it from
        // the invariant it depends on collision resolution upholding.
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/core/test/toolgen-layout.test.ts"],
      "rules": {
        // Off: comments in this test file intentionally start with the
        // lowercase identifier `paramFields` or the lowercase
        // JSON-Schema/OpenAPI keyword `allowReserved` -- capitalizing them
        // would misname the identifier or keyword, same rationale as the
        // toolgen-schema.test.ts override above.
        "capitalized-comments": "off"
      }
    },
    {
      "files": ["packages/cli/src/context.ts"],
      "rules": {
        // Off: context.ts is the sole home of the real cache filesystem seam
        // -- mkdirSecure's per-component umask-0177 walk, writeFileAtomic's
        // temp-then-rename write, readFileTextCapped's capped read, and the
        // lstat-based rejectUnlessRealDirectory symlink guard (used by both
        // of mkdirSecure's branches) all depend on being reasoned about
        // together as one filesystem-safety invariant; splitting any one of
        // them out would separate it from the seam it protects.
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/core/src/server/sdk/streamable-http.ts"],
      "rules": {
        // Off: streamable-http.ts is the whole HTTP front door -- the
        // request-guard-before-anything-else ordering, the POST-only method
        // gate, the 4 MB body cap and fatal-UTF-8 parse that both have to run
        // BEFORE the SDK adapter converts the request, and the two-phase
        // bounded graceful shutdown are one irreducible sequence, and each
        // step's rationale cites the exact adapter/handler behavior it
        // compensates for (the adapter's eager body buffering, its own 500
        // fallback, what handler.close() does to an in-flight exchange).
        // Splitting the sequence across files would separate those citations
        // from the code whose ordering they justify, which is itself the
        // load-bearing part.
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/core/src/http/egress.ts"],
      "rules": {
        // Off: classifyAddress's IPv6 arm fails closed on the full set of
        // SSRF-relevant IANA special-purpose ranges plus RFC 6052/8215's
        // NAT64 IPv4-embedding rules, including reclassifying the local-use
        // NAT64 prefix 64:ff9b:1::/48 as metadata (a /96 translator inside
        // it can wrap the metadata address) -- the citation for each range
        // sits next to the check it justifies so a future edit can't narrow
        // a range without seeing why it exists, which pushes the file past
        // 300 lines.
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/core/src/server/execute/executor.ts"],
      "rules": {
        // Off: executor.ts is the whole integration point wiring
        // request-building, the pinned transport, response-mapping,
        // redaction, and the concurrency semaphore -- sanitizing a
        // buildRequest error's spec-derived wireName and assembleHeaders's
        // header-precedence write order both depend on seeing the full call
