{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error"
  },
  "rules": {
    "capitalized-comments": ["error", "always", { "ignoreConsecutiveComments": true }],
    "sort-keys": "off",
    "sort-imports": "off",
    "no-magic-numbers": "off",
    // Off per task-2 brief: A/R (cache/errors.ts's withCacheErrors) and T
    // (cache/lock.ts's withNamespaceLockImpl) are the frozen generic type
    // parameters from the Interface Contract's withNamespaceLock<T> signature.
    // v/k/t added per task-1 brief (M3): toolgen/schema.ts's malformedKeyword,
    // conflictingCombination, stringSchema, numberSchema, enumSchema, and build
    // use these single-letter parameter/loop-variable names verbatim throughout.
    "id-length": ["error", { "min": 2, "exceptions": ["s", "m", "h", "d", "z", "A", "R", "T", "v", "k", "t"] }],
    "import/no-named-export": "off",
    "import/group-exports": "off",
    "import/no-nodejs-modules": "off",
    "import/no-unassigned-import": "off",
    "import/exports-last": "off",
    "import/prefer-default-export": "off",
    "unicorn/require-module-specifiers": "off",
    "no-ternary": "off", // ternary used by core errors.ts per task-2 brief
    // Off per task-2 brief: sanitize.ts's control/bidi-stripping regex matches control-character ranges verbatim
    "no-control-regex": "off",
    // Off per task-4 brief: context.ts uses node:fs existsSync verbatim
    "node/no-sync": "off",
    // Off per task-4 brief: context.ts testContext().homeDir default returns undefined verbatim
    "unicorn/no-useless-undefined": "off",
    // Off per task-11 brief (M2b): cache.ts's promoteCandidate/withNamespaceLock
    // call sites take four parameters verbatim
    "max-params": "off",
    // Off per task-4 brief: output.ts wrapAction() catch binding is named "err" verbatim
    "unicorn/catch-error-name": "off",
    // Off per task-5 brief: main.ts imports `{ emitError, type OutputOptions }` from './output.ts' verbatim
    "import/consistent-type-specifier-style": "off",
    // Off per task-3 brief (M2a): headers.ts's resolveHeaderEnvMappings has 14 statements verbatim
    "max-statements": "off",
    // Off per task-4 brief (M2a): load.ts's stat/read try-catch blocks assign url/size/text after declaration verbatim
    "init-declarations": "off",
    // Deferred/race primitives around the non-abortable dns.promises.lookup:
    // a legitimate promise-constructor use plus detached late-rejection handlers
    "promise/avoid-new": "off",
    "promise/prefer-await-to-then": "off",
    // Off per task-5 brief (M2a): egress.ts's classifyIpv4/classifyAddress branch
    // comments are inline per condition verbatim
    "no-inline-comments": "off",
    // Off per task-5 brief (M2a): egress.ts's IPv6 range constants (0xfc00,
    // 0xfdff, 0xfe80, 0xfebf, 0xffff) are lowercase and ungrouped verbatim
    "unicorn/number-literal-case": "off",
    "unicorn/numeric-separators-style": "off",
    // Off per task-5 brief (M2a): egress.ts's assertAllowedRedirectTarget and
    // fetch.ts's fetchSpec exceed 50 lines verbatim
    "max-lines-per-function": "off",
    // Off per task-5 brief (M2a): fetch.ts's manual redirect loop and streamed
    // body read are inherently serial (the chain and stream cannot be parallelized)
    "no-await-in-loop": "off",
    // Off per task-5 brief (M2a): fetch.ts's redirect loop uses `continue` verbatim
    "no-continue": "off"
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/coverage/**", "packages/*/bin/**"],
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "plugins": ["vitest"],
      "rules": {
        // Off per task-4 brief (M4): "vitest/prefer-called-once" and
        // "vitest/prefer-called-times" directly contradict each other for a
        // `toHaveBeenCalledTimes(1)` call site (one demands
        // `toHaveBeenCalledOnce()`, the other demands `toHaveBeenCalledTimes(1)`
        // for the exact same assertion) - no rewrite satisfies both
        // simultaneously. Kept "prefer-called-times" (it matches this
        // codebase's existing convention, e.g.
        // context-createexclusive.test.ts's `toHaveBeenCalledTimes(0)`) and
        // turned the other off here rather than weakening the "style"
        // category as a whole.
        "vitest/prefer-called-once": "off",
        "vitest/no-hooks": "off",
        "vitest/max-expects": "off",
        // Off per task-2 brief: spec test file omits explicit assertion counts
        "vitest/prefer-expect-assertions": "off",
        // Off per task-2 brief: spec test file imports describe/it/expect from 'vitest' (globals disabled)
        "vitest/no-importing-vitest-globals": "off",
        // Off per task-2 brief: spec test file uses "EXIT map" as a proper-noun-style title
        "vitest/prefer-lowercase-title": "off",
        // Off per task-2 brief: spec test file names a describe block after the imported factory
        "vitest/prefer-describe-function-title": "off",
        // Off per task-2 brief: spec test file uses toEqual, not toStrictEqual
        "vitest/prefer-strict-equal": "off",
        // Off per task-3 brief: primitives.test.ts asserts safeParse(...).success with toBe(false) verbatim
        "vitest/prefer-to-be-falsy": "off",
        // Off per task-3 brief: primitives.test.ts uses toThrowError verbatim
        "vitest/no-alias-methods": "off",
        // Off per task-3 brief: primitives.test.ts asserts inside a try/catch verbatim
        "vitest/no-conditional-expect": "off",
        // Off per task-4 brief: context.test.ts asserts typeof ctx.homeDir() with toBe('string') verbatim
        "vitest/prefer-expect-type-of": "off",
        // Off per task-4 brief: output.test.ts uses `{ a: 1 }` as sample payload data verbatim
        "id-length": "off",
        // Off per task-5 brief: main.test.ts's `describe('run', ...)` callback is 60 lines verbatim
        "max-lines-per-function": "off",
        // Off per task-6 brief: doctor.test.ts asserts envelope.ok/cacheRootExists with toBe(true) verbatim
        "vitest/prefer-to-be-truthy": "off",
        // Off per task-1 brief: main.test.ts defines inline CommandRegistrar closures (boom/helpToStderr) verbatim
        "unicorn/consistent-function-scoping": "off",
        // Off per task-3 brief (M2a): headers.test.ts's expectUsageError helper wraps the assertions verbatim
        "vitest/expect-expect": "off",
        // Off per task-4 brief (M2a): load.test.ts narrows source.kind with an if inside the test verbatim
        "vitest/no-conditional-in-test": "off",
        // Off per task-5 brief (M2a): fetch.test.ts's fixtures use the Fetch API's
        // `null` response body / header values verbatim
        "unicorn/no-null": "off",
        // Off per task-5 brief (M2a): fetch.test.ts's redirect-chain test suite exceeds 300 lines
        "max-lines": "off",
        // Off per task-1 brief: sanitize.test.ts and output.test.ts embed escaped
        // backslashes ('\\x', '\\u001b') as literal string content verbatim
        "unicorn/prefer-string-raw": "off",
        // Off per task-2 brief: cache-lock.test.ts and context.test.ts use
        // expect(await ...) rather than await expect(...).resolves throughout, verbatim
        "vitest/prefer-expect-resolves": "off",
        // Off per task-2 brief: context.test.ts's writeFileAtomic/readFileTextCapped
        // failure-path tests assert only that a real fs error is thrown, not its
        // message (the exact message is filesystem-dependent), verbatim
        "vitest/require-to-throw-message": "off",
        // Off per task-2 brief: cache-paths.test.ts's D9 collision test writes the
        // namespace material as two concatenated literals to mirror the two-part
        // construction it is testing against, verbatim
        "no-useless-concat": "off",
        // Off per task-3 brief (M2b): cache-store.test.ts's mulberry32 PRNG needs
        // the exact unsigned 32-bit wraparound `>>> 0` gives; Math.trunc keeps
        // sign and does not wrap, which would silently change the generated
        // sequence, verbatim
        "unicorn/prefer-math-trunc": "off",
        // Off per task-3 brief (M2b): cache-store.test.ts's round-5 finding 3
        // case constructs a genuinely sparse array ([1, , 3]) to verify
        // serializedSizeWithin rejects it - replacing the hole would test a
        // different, already-covered value, verbatim
        "no-sparse-arrays": "off",
        // Off per task-3 brief (M2b): cache-store.test.ts's round-6 finding 1
        // cases construct boxed primitives (new Number/String/Boolean)
        // specifically to verify serializedSizeWithin refuses them; the
        // unboxed-literal replacement these rules suggest is a plain primitive,
        // which defeats the test, verbatim
        "unicorn/new-for-builtins": "off",
        "no-new-wrappers": "off"
      }
    },
    {
      "files": ["packages/core/src/spec/pipeline.ts"],
      "rules": {
        // Off for the pipeline only: it is the composition root of the spec
        // subsystem and imports load, parse, validate, dereference, normalize,
        // naming, budgets, fetch, cache paths/fs/store/ttl, and the filter engine
        "import/max-dependencies": "off",
        // Off per task-9 brief: pipeline.ts is where every M2b part meets -
        // policy resolution, the D5 fail-closed read, the conditional refresh,
        // the D16b cache-hit path, the last-known-good fallback, and the D16a2
        // finish/commitRefresh helpers live together by design, and the
        // extensive round-N rationale comments documenting each control-flow
        // decision are load-bearing security documentation, not incidental -
        // so it verbatim exceeds 300 lines
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/core/src/cache/store.ts"],
      "rules": {
        // Off per task-3 brief (M2b): cache/store.ts is the transactional store
        // core - schema serialization, the D14 incremental size preflight, both
        // writers, GC, the three-way meta read, and the public reader all live in
        // one module by design (readMetaFile is private and shared by every entry
        // point in it) - so it verbatim exceeds 300 lines
        "max-lines": "off",
        // Off per task-11 brief (M2b): scoping import/max-dependencies to
        // pipeline.ts only (rather than disabling it repository-wide) puts the
        // rule back in force here too, and store.ts imports from 11 files for
        // the same reason its max-lines override above gives - it is the
        // transactional store core and genuinely draws on every one of them
        "import/max-dependencies": "off",
        // Off per task-3 brief (M2b): store.ts's writeAccepted and writeCandidate
        // are declared async with synchronous validation (declaredOpenapiVersion,
        // persistableTextOrThrow, the title/specVersion length check) BEFORE the
        // `return withNamespaceLock(...)` tail call. Removing `async` would turn
        // those synchronous throws into synchronous exceptions at the call site
        // instead of promise rejections, breaking every `.rejects.toMatchObject`
        // assertion against them - not behavior-preserving
        "require-await": "off"
      }
    },
    {
      "files": ["packages/core/src/filter/pattern.ts"],
      "rules": {
        // Off per task-6 brief: pattern.ts is the whole D15 token-programme
        // module - the grammar constants, compileGlob, the step budget, and
        // the Thompson state-set matcher live together by design (the design
        // rationale comments are load-bearing, not incidental), so it
        // verbatim exceeds 300 lines
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/core/src/http/pinned-dispatcher.ts"],
      "rules": {
        // Off per task-3 brief (M5): pinnedLookup implements node:net's
        // LookupFunction / undici's connect.lookup contract, which Node
        // itself defines as a callback (hostname, options, callback) => void
        // - there is no async/await form of this external API to refactor to
        "promise/prefer-await-to-callbacks": "off",
        // Off per task-3 brief (M5): the LookupFunction callback's first
        // parameter is typed `NodeJS.ErrnoException | null` (not `| undefined`)
        // by node:net itself, so the success-path calls must pass the literal
        // `null` verbatim to satisfy that upstream type
        "unicorn/no-null": "off",
        // Off per task-4 brief (M5): the plan's own file layout puts
        // createPinnedAgent (Task 3) and pinnedRequest (Task 4) — the
        // DNS-pinning Agent and the shared manual-redirect transport built
        // directly on it — in this one module by design, with load-bearing
        // round-1 amendment rationale comments throughout, so it
        // verbatim exceeds 300 lines (mirrors the pipeline.ts/store.ts/
        // layout.ts/context.ts overrides above for the same reason)
        "max-lines": "off",
        // Off per task-4 brief (M5): TooLargeError (the over-cap sentinel
        // readCapped throws) and EgressError (the branded error the
        // DNS-pinning lookup throws so a fetch rejection can be classified
        // reliably via its cause chain, per the round-1 amendment) are
        // two small, single-purpose sentinel classes serving two distinct
        // call sites within this one shared-transport module — splitting
        // either into its own file would separate a brand from the single
        // guard it exists to make provable
        "max-classes-per-file": "off"
      }
    },
    {
      "files": ["packages/core/src/toolgen/schema.ts"],
      "rules": {
        // Off per task-1 brief (M3): schema.ts is the full converter framework -
        // the malformed-value gate, the keyword allowlist, the sibling-conflict
        // gate, the nullable/multi-type normalization, and every leaf branch
        // (string/number/integer/boolean/null/const/enum/typeless) live together
        // by design (the round-N rationale comments are load-bearing security
        // documentation, not incidental), so it verbatim exceeds 300 lines even
        // before Task 2 adds the composite branches
        "max-lines": "off",
        // Off per task-1 brief (M3): the "oneOf / anyOf + type" comment in
        // conflictingCombination intentionally starts with the lowercase
        // JSON-Schema keyword names oneOf/anyOf, verbatim
        "capitalized-comments": "off"
      }
    },
    {
      "files": ["packages/core/test/toolgen-schema.test.ts"],
      "rules": {
        // Off per task-1 brief (M3): several comments in this test file
        // intentionally start with a lowercase code identifier (nullable,
        // numberSchema, enum, pattern) to name the exact keyword/function being
        // discussed, verbatim
        "capitalized-comments": "off",
        // Off per task-1 brief (M3): the keyword-allowlist `it.each` fixture for
        // the `if` keyword includes a sibling `then: {}` property because it is
        // a literal JSON Schema `if`/`then` node under test, not a thenable,
        // verbatim
        "unicorn/no-thenable": "off"
      }
    },
    {
      "files": ["packages/core/src/toolgen/layout.ts"],
      "rules": {
        // Off per task-4 brief (M3): layout.ts is the whole field-layout module -
        // paramFields, the body classification (bodyFields/isFlattenableRoot/
        // selectMedia), collision resolution, and buildLayout's assembly
        // (including the optional-body all-or-nothing refine) live together by
        // design, with load-bearing round-N security rationale comments
        // throughout, so it verbatim exceeds 300 lines
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/core/test/toolgen-layout.test.ts"],
      "rules": {
        // Off to support task-3's verbatim converged code (M3): comments in
        // this test file intentionally start with the lowercase identifier
        // `paramFields` or the lowercase JSON-Schema/OpenAPI keyword
        // `allowReserved`, verbatim (same rationale as the
        // toolgen-schema.test.ts override above)
        "capitalized-comments": "off",
        // Off to support task-3's verbatim converged code (M3): the round-15 reserved-header assertions
        // nest `expect(okFields(paramFields(op([...` (4 calls) verbatim, one
        // level deeper than the file's usual `const fields = okFields(paramFields(op([...`
        // assignment form, to assert the mapped result inline
        "unicorn/max-nested-calls": "off"
      }
    },
    {
      "files": ["packages/cli/src/context.ts"],
      "rules": {
        // Off per task-12 brief (M2b final review, finding 2):
        // context.ts is the sole home of the real cache filesystem seam, and
        // mkdirSecure's per-component umask-0177 walk plus writeFileAtomic's
        // D3 temp+rename and readFileTextCapped's D12 capped read already
        // carry load-bearing round-N rationale by design. Fixing the round-10
        // symlink-following finding added an lstat-based
        // rejectUnlessRealDirectory guard, used in both of mkdirSecure's
        // branches, with rationale comments that are load-bearing security
        // documentation, not incidental. A comment-free version of the same
        // fix still lands a few lines past 300 (there was no headroom left),
        // so trimming the fix's own rationale could not have closed the gap
        // either — this mirrors the pattern.ts/store.ts/pipeline.ts overrides
        // above for the same reason
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/core/src/server/sdk-v1/streamable-http.ts"],
      "rules": {
        // Off per task-8 brief: streamable-http.ts is the single home of the
        // Streamable HTTP listener wiring — the session-capacity
        // synchronous-reservation fix (C4) and its rollback (C4-rollback),
        // the request-guard-before-transport wiring (Task 7), the 4 MB
        // body-cap/parse-error handling, and the two-phase bounded graceful
        // shutdown (C5) each carry load-bearing round-N security rationale
        // comments by design (see the file's own comments for the exact
        // SDK-source verification each one cites). Splitting any of these
        // across files would separate a fix from the exact SDK behavior it
        // documents, which is itself the load-bearing artifact — this
        // mirrors the context.ts/layout.ts overrides above for the same
        // reason
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/core/src/http/egress.ts"],
      "rules": {
        // Off per the M5 final-review fix wave: classifyAddress's IPv6 arm
        // already fails closed on the full set of SSRF-relevant IANA
        // special-purpose ranges (Task 1) plus RFC 6052/8215's NAT64
        // IPv4-embedding rules; the final-review fix additionally reclassifies
        // the local-use NAT64 prefix 64:ff9b:1::/48 as metadata (a /96
        // translator inside it can wrap the metadata address), which pushed
        // the file's load-bearing rationale comments verbatim past 300 lines
        // (mirrors the pipeline.ts/store.ts/layout.ts/pinned-dispatcher.ts/
        // request.ts/response.ts overrides above for the same reason)
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/core/src/server/execute/executor.ts"],
      "rules": {
        // Off per the M5 final-review fix wave: executor.ts is the whole
        // integration point wiring request-building + the pinned transport +
        // response-mapping + redaction + the concurrency semaphore; two
        // final-review findings (sanitizing a buildRequest error's
        // spec-derived wireName, and reordering assembleHeaders's write order
        // to match design §4 precedence) each added load-bearing rationale
        // comments in place rather than splitting this one cohesive module,
        // pushing it verbatim past 300 lines (mirrors the pipeline.ts/
        // store.ts/layout.ts/pinned-dispatcher.ts/request.ts/response.ts
        // overrides above for the same reason)
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/core/src/server/execute/request.ts"],
      "rules": {
        // Off per task-7 brief (M5): request.ts is the whole request-building
        // module — the value-shape guard, per-leaf percent-encoding, the
        // path-traversal reject, query/header/body serialization for every
        // style x explode combination the mapper can emit, and the outbound
        // budget checks live together by design, with load-bearing
        // research-citation and round-1 amendment rationale comments
        // throughout, so it verbatim exceeds 300 lines (mirrors the
        // pipeline.ts/store.ts/layout.ts/pinned-dispatcher.ts overrides above
        // for the same reason)
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/core/src/server/execute/response.ts"],
      "rules": {
        // Off per task-8 brief (M5): response.ts is the whole response-mapping
        // module — the local Ajv2020 envelope-validator compiler, the fixed
        // PinnedOutcome-error text table, the byte-safe UTF-8 decode/redact/
        // sanitize/truncate/scan pipeline shared by the error-excerpt and
        // no-outputSchema text paths, and the schema-branch envelope builder
        // live together by design, with load-bearing research-citation and
        // round-1 amendment rationale comments throughout (see the
        // file's own comments), so it verbatim exceeds 300 lines (mirrors the
        // pipeline.ts/store.ts/layout.ts/pinned-dispatcher.ts/request.ts
        // overrides above for the same reason)
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/cli/src/api-options.ts"],
      "rules": {
        // Off per task-9 review-fix amendment (M5): the file was an exact
        // 300-line fit before two credential-leak/usability findings
        // (--base-url and --header rejections echoed raw secret
        // values; RFC 9110 OWS trimming) added redactedBaseUrl,
        // trimOptionalSpace, and an empty-after-trim guard in place - these
        // stay in this module by design (they are one cohesive parse/
        // validate pass over the same two flags), so it now verbatim
        // exceeds 300 lines
        "max-lines": "off"
      }
    },
    {
      "files": ["packages/cli/src/commands/serve.ts"],
      "rules": {
        // Off per task-11 brief (M5, the milestone's activation): resolving
        // the API base URL (resolveBaseUrl + assertBaseUrlShape), building
        // the process-wide redactor, eager-compiling the per-tool output
        // validators (D7), and constructing the ONE shared createExecutor
        // instance all belong in this single startup action alongside the
        // pre-existing HTTP-option/spec-pipeline wiring - splitting them into
        // a separate module would only hide the ordering constraints the
        // brief itself specifies (apiConfig before buildTools, base-url
        // resolution before the executor, etc.), so it verbatim exceeds 300
        // lines
        "max-lines": "off"
      }
    }
  ]
}
