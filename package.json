{
  "name": "openapi-mcp-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.11",
    "pnpm": ">=11"
  },
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt packages vitest.config.ts vitest.shared.ts",
    "fmt:check": "oxfmt --check packages vitest.config.ts vitest.shared.ts",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r run build",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test:coverage"
  },
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024",
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
