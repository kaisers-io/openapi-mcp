{
  "name": "openapi-mcp-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt packages vitest.config.ts vitest.shared.ts",
    "fmt:check": "oxfmt --check packages vitest.config.ts vitest.shared.ts",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r run build",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test:coverage"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "devDependencies": {
    "@tsconfig/node24": "24.0.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
