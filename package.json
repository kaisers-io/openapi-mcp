{
  "name": "openapi-mcp-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.11",
    "pnpm": ">=11"
  },
  "scripts": {
    "lint": "oxlint",
    "fmt": "oxfmt packages scripts/bench vitest.config.ts vitest.shared.ts vitest.coverage.ts vitest.coverage-merge.ts",
    "fmt:check": "oxfmt --check packages scripts/bench vitest.config.ts vitest.shared.ts vitest.coverage.ts vitest.coverage-merge.ts",
    "typecheck": "pnpm -r run typecheck && tsc -p scripts/bench",
    "bench": "node scripts/bench/run.ts",
    "bench:compare": "node scripts/bench/compare.ts",
    "bench:baseline": "node scripts/bench/run.ts --out scripts/bench/baseline.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r run build",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test:coverage"
  },
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
