{
  "openapi": "3.1.0",
  "info": {
    "title": "Shop",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://shop.example.test/api"
    }
  ],
  "paths": {
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "summary": "Create an order",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "operationId": "getOrder",
        "summary": "Get order",
        "description": "Get order.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "operationId": "getCustomer",
        "summary": "Get customer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The customer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "required": [
          "id",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "note": {
            "description": "Free-text note from the customer",
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "OrderInput": {
        "type": "object",
        "required": [
          "note"
        ],
        "properties": {
          "note": {
            "type": "string",
            "description": "Free-text note from the customer"
          }
        },
        "additionalProperties": false
      },
      "Customer": {
        "type": "object",
        "required": [
          "id",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "description": "Internal note about the customer"
          }
        }
      }
    }
  }
}